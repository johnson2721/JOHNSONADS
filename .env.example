# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
APP_URL=http://localhost:3000
# Build with HTTPS APP_URL (or set this to 1) for clickjacking protection.
ENFORCE_FRAME_DENY=0
# Generate with: openssl rand -hex 32. Retain securely across deploys.
JDE_VAULT_KEY=
# Generate a different random secret: openssl rand -hex 32.
JOBS_TOKEN=
# Disable illustrative marketplace examples for commercial launch.
JDE_SEED_EXAMPLES=0
MARKETPLACE_COMMISSION_PERCENT=5
# Set only if the HTTPS proxy strips and overwrites this header.
TRUST_PROXY_IP_HEADER=

# Transactional SMTP. Port 465 uses implicit TLS; default 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Leave off except with a locally controlled SMTP capture server.
SMTP_ALLOW_INSECURE=0
ADMIN_NOTIFICATION_EMAIL=johnsonkanyiri0@gmail.com
# Private login identity can differ from the notification inbox.
ADMIN_LOGIN_EMAIL=johnsonkanyiri0@gmail.com

# Private AWS or S3-compatible storage. The standard AWS credential chain is supported.
REQUIRE_CLOUD_STORAGE=0
S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# M-Pesa Express (Daraja). Use a public HTTPS APP_URL for callbacks.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_ORDER_LIMIT_KES=250000

# Lipwa / Pay Hero hosted checkout, enabled by default. Use 0 to hide while setting up.
LIPWA_ENABLED=1
LIPWA_PAYMENT_URL=https://lipwa.link/10283
LIPWA_ORDER_LIMIT_KES=250000
# API credentials for the same merchant account that owns the link. Server-side only.
LIPWA_PAYHERO_API_USERNAME=
LIPWA_PAYHERO_API_PASSWORD=

# PayPal Orders v2. KES prices are converted to USD at the configured storefront rate.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_KES_PER_USD=

# Disabled by default. Enable only after confirming merchant eligibility and applicable law.
BINANCE_PAY_ENABLED=0
BINANCE_PAY_COUNTRIES=
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_KES_PER_USDT=
BINANCE_WEBHOOK_CERT_SN=
BINANCE_WEBHOOK_PUBLIC_KEY=

# For scripts/backup.sh (encrypted off-site backups)
BACKUP_DIR=
BACKUP_AGE_RECIPIENT=
